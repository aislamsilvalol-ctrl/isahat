# IsaHat environment configuration (copy to .env; never commit real secrets).
# All values are optional; IsaHat runs fully offline with sensible defaults.

# Where IsaHat stores its local database and state.
# Defaults to ~/.isahat if unset.
ISAHAT_HOME=

# Disable coloured output (any non-empty value).
# NO_COLOR=1

# --- AI assistance (Phase 4, all optional and OFF by default) ---
# IsaHat prioritises local models and never sends data externally without consent.

# Provider: "none" (default), "ollama", or an external provider name.
ISAHAT_AI_PROVIDER=none

# For local models via Ollama:
# ISAHAT_OLLAMA_HOST=http://127.0.0.1:11434
# ISAHAT_AI_MODEL=llama3.1

# For an external provider (only used if you explicitly opt in):
# ISAHAT_AI_API_KEY=
